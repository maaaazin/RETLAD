{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "datasource": {"type": "postgres", "uid": "log-analytics-postgres"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"format": "time_series", "rawSql": "SELECT window_start AS \"time\", total_requests AS \"Requests\", total_errors AS \"Errors\" FROM request_metrics WHERE $__timeFilter(window_start) ORDER BY 1", "refId": "A"}],
      "title": "Requests and Errors per Minute",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "log-analytics-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 20}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}},
      "targets": [{"format": "time_series", "rawSql": "SELECT window_start AS \"time\", error_rate_percent AS \"Error rate\" FROM request_metrics WHERE $__timeFilter(window_start) ORDER BY 1", "refId": "A"}],
      "title": "HTTP Error Rate (%)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "postgres", "uid": "log-analytics-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 9, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [{"format": "table", "rawSql": "SELECT endpoint AS \"Endpoint\", SUM(total_requests) AS \"Requests\" FROM endpoint_metrics WHERE $__timeFilter(window_start) GROUP BY endpoint ORDER BY 2 DESC LIMIT 10", "refId": "A"}],
      "title": "Top Endpoints by Requests",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "postgres", "uid": "log-analytics-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1000}, {"color": "red", "value": 2000}]}, "unit": "ms"}, "overrides": []},
      "gridPos": {"h": 9, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [{"format": "table", "rawSql": "SELECT endpoint AS \"Endpoint\", ROUND(AVG(average_response_time_ms), 2) AS \"Average response time\" FROM endpoint_metrics WHERE $__timeFilter(window_start) GROUP BY endpoint ORDER BY 2 DESC LIMIT 10", "refId": "A"}],
      "title": "Slowest Endpoints (ms)",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "postgres", "uid": "log-analytics-postgres"},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [{"format": "table", "rawSql": "SELECT detected_at AS \"Detected at\", severity AS \"Severity\", anomaly_type AS \"Alert type\", COALESCE(ip_address::text, endpoint, '-') AS \"Affected target\", description AS \"Description\" FROM anomalies WHERE $__timeFilter(detected_at) ORDER BY detected_at DESC LIMIT 25", "refId": "A"}],
      "title": "Active Anomaly Alerts",
      "type": "table"
    },
    {
      "datasource": {"type": "postgres", "uid": "log-analytics-postgres"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
      "id": 6,
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [{"format": "table", "rawSql": "SELECT ip_address::text AS \"IP address\", SUM(request_count) AS \"Requests\" FROM ip_metrics WHERE $__timeFilter(window_start) GROUP BY ip_address ORDER BY 2 DESC LIMIT 10", "refId": "A"}],
      "title": "Top IP Addresses by Requests",
      "type": "bargauge"
    }
  ],
