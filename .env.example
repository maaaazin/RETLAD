# Kafka uses localhost:29092 from your Mac and kafka:9092 from Docker containers.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=web_logs

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=log_analytics
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=change_this_password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_password

ERROR_RATE_THRESHOLD=10
REQUESTS_PER_IP_THRESHOLD=50
SLOW_RESPONSE_THRESHOLD_MS=1000

